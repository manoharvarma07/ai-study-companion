# Base URL of the Spring Boot backend (required — no default production fallback).
VITE_API_BASE_URL=http://localhost:8080
# Opt-in dev mock data, used ONLY when the backend is unreachable.
# Keep "false" to verify the real integration. All mock logic lives in
# src/api/mock.ts and can be deleted once fully integrated.
VITE_USE_MOCKS=false
