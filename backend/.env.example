# Copy to .env (or export) and adjust. Never commit real secrets.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/ai_study
SPRING_DATASOURCE_USERNAME=aistudy
SPRING_DATASOURCE_PASSWORD=aistudy_dev

# JWT (use a long random string in production!)
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes-long!!
JWT_EXPIRATION_MS=86400000

# AI via OpenRouter (optional). If OPENROUTER_API_KEY is empty, the backend uses a
# deterministic offline heuristic so the full learning loop still works.
# NOTE: application.properties reads OPENROUTER_* (not OPENAI_*).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=60000

# Retrieval
RAG_TOP_K=5

# Local upload storage (prototype). S3/Supabase can back StorageService later.
STORAGE_LOCATION=./storage

# Server port
PORT=8080

# CORS: comma-separated frontend origin(s). Production MUST set this to the
# deployed frontend URL, e.g. CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Hibernate SQL logging (keep false in production)
SHOW_SQL=false

# Offline heuristic fallback when live AI fails or no key is set.
# Set false in production if provider errors must surface instead.
AI_OFFLINE_FALLBACK=true
